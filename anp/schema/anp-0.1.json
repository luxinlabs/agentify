{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/luxinlabs/agentify/anp/schema/anp-0.1.json",
  "title": "Agent-Native Product (ANP) listing",
  "description": "v0.1 draft — machine-readable product listing for AI agent commerce (Argosy).",
  "type": "object",
  "required": ["anpVersion", "product", "offers", "policies", "provenance"],
  "properties": {
    "anpVersion": { "type": "string", "const": "0.1" },
    "product": {
      "type": "object",
      "required": ["id", "name"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "brand": { "type": "string" },
        "description": { "type": "string" },
        "category": { "type": "string" },
        "imageUrls": { "type": "array", "items": { "type": "string", "format": "uri" } },
        "specifications": { "type": "object", "description": "Typed key/value specs, e.g. {\"waterproof_rating\": \"IPX7\"}" }
      }
    },
    "identifiers": {
      "type": "object",
      "properties": {
        "sku": { "type": "string" },
        "gtin": { "type": "string" },
        "mpn": { "type": "string" }
      }
    },
    "offers": {
      "type": "object",
      "required": ["price", "currency", "availability"],
      "properties": {
        "price": { "type": "number", "minimum": 0 },
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
        "availability": { "type": "string", "enum": ["in_stock", "out_of_stock", "preorder"] },
        "inventoryQuantity": { "type": "integer", "minimum": 0 },
        "priceValidUntil": { "type": "string", "format": "date-time" }
      }
    },
    "fulfillment": {
      "type": "object",
      "properties": {
        "shippingOptions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "maxDeliveryDays"],
            "properties": {
              "name": { "type": "string" },
              "cost": { "type": "number", "minimum": 0 },
              "currency": { "type": "string" },
              "maxDeliveryDays": { "type": "integer", "minimum": 1 }
            }
          }
        }
      }
    },
    "policies": {
      "type": "object",
      "required": ["returns"],
      "properties": {
        "returns": {
          "type": "object",
          "required": ["allowed", "windowDays"],
          "properties": {
            "allowed": { "type": "boolean" },
            "windowDays": { "type": "integer", "minimum": 0 },
            "conditions": { "type": "string" }
          }
        },
        "warranty": { "type": "string" },
        "authenticityGuarantee": { "type": "boolean" },
        "ageRestricted": { "type": "boolean" }
      }
    },
    "checkout": {
      "type": "object",
      "properties": {
        "ucpEndpoint": { "type": "string", "format": "uri" },
        "acpEndpoint": { "type": "string", "format": "uri" }
      }
    },
    "trust": {
      "type": "object",
      "properties": {
        "merchantId": { "type": "string" },
        "attestationUri": { "type": "string", "format": "uri", "description": "Signed merchant verification record (Argosy trust registry)" }
      }
    },
    "provenance": {
      "type": "object",
      "required": ["source", "lastVerified"],
      "properties": {
        "source": { "type": "string", "description": "Where this listing data came from" },
        "lastVerified": { "type": "string", "format": "date-time" },
        "verifiedBy": { "type": "string" }
      }
    }
  }
}
